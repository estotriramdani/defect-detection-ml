# Salin menjadi .env lalu sesuaikan nilainya.
# File .env tidak di-commit (lihat .gitignore).

# Flask
SECRET_KEY=ganti-dengan-string-acak
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5001

# Autentikasi area admin (training & manajemen dataset).
# Kosongkan ADMIN_PASSWORD untuk menonaktifkan autentikasi (khusus development).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ambang deteksi unknown
CONFIDENCE_THRESHOLD=0.6
ANOMALY_THRESHOLD=1.5

# Training
TRAIN_MIN_PER_CLASS=5

# Upload
MAX_CONTENT_LENGTH=16777216

# Path opsional (default sudah sesuai struktur proyek)
# MODEL_PATH=models/defect_detection_model.pkl
# UPLOAD_FOLDER=static/uploads
# TRAINING_DATA_FOLDER=static/training_data
